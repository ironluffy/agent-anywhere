{
  "modules": {
    "hub_connector": {
      "enabled": true,
      "hub_url": "localhost:50052",
      "log_level": "INFO",
      "batch_size": 10,
      "flush_interval_ms": 1000
    },
    "autocorrect": {
      "enabled": true,
