# Agent Anywhere Configuration
# Copy this file to .env and update the values

# ==============================================================================
# CORE CONFIGURATION
# ==============================================================================

# Optional: Path to the agent-anywhere repository
# Only needed if scripts are not installed in standard locations
# The system will automatically try to find scripts in:
# 1. Environment variable paths (see script paths below)
# 2. This AANY_REPO_PATH/aany-tmux/ directory
# 3. Standard system paths (/usr/local/bin, /opt/homebrew/bin, etc.)
# 4. User paths (~/.local/bin, ~/bin)
# 5. Relative to the current executable
# AANY_REPO_PATH=/path/to/agent-anywhere

# ==============================================================================
# LOGGING CONFIGURATION
# ==============================================================================

# Optional: Hub URL for centralized logging (defaults to localhost:50052)
# This is where logs are sent when using the tmux loggers
# AANY_HUB_URL=localhost:50052

# Optional: Disable all logging functionality
# Set to true to disable tmux logging, interaction logging, and screenshot logging
# AANY_LOGGING_DISABLED=false

# ==============================================================================
# SCRIPT PATHS
# ==============================================================================
# These allow you to override the default script locations
# If not set, the system will search for scripts using the strategies listed above

# Claude wrapper script that handles return codes
# AANY_CLAUDE_WRAPPER=/path/to/claude-with-return.sh

# Tmux session logger for capturing terminal output
# AANY_TMUX_LOGGER=/path/to/tmux-logger.sh

# Interaction logger for capturing all screen content and user input
# AANY_INTERACTION_LOGGER=/path/to/tmux-interaction-logger.sh

# Screenshot logger for periodic visual captures (5s interval, 5min rotation)
# AANY_SCREENSHOT_LOGGER=/path/to/tmux-screenshot-rotating-logger.sh

# ==============================================================================
# AGENT-SPECIFIC ENVIRONMENT VARIABLES
# ==============================================================================
# These are typically set in individual agent .env files (agents/*/workspace/.env)
# rather than globally, but can be set here for defaults

# Git repository to clone when starting an agent
# If set, the agent will clone this repository into its workspace on startup
# GIT_REPO=https://github.com/username/repository.git

# Additional custom environment variables for your agents
# These will be available in the agent's tmux session
# CUSTOM_VAR=value

# ==============================================================================
# GRPC CONFIGURATION (used internally by loggers)
# ==============================================================================
# These are set automatically by the system when spawning logger processes
# GRPC_ENABLE_FORK_SUPPORT=1
# GRPC_POLL_STRATEGY=poll