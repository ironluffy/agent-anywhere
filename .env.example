# Agent Anywhere Environment Variables
# Copy this file to .env and update with your local paths

# Base repository path (REQUIRED)
# Set this to the absolute path of your agent-anywhere repository
AANY_REPO_PATH=/path/to/your/agent-anywhere

# Optional: Override default script paths if needed
# AANY_CLAUDE_WRAPPER=${AANY_REPO_PATH}/aany-tmux/claude-with-return.sh
# AANY_TMUX_LOGGER=${AANY_REPO_PATH}/aany-tmux/tmux-logger.sh
# AANY_INTERACTION_LOGGER=${AANY_REPO_PATH}/aany-tmux/tmux-interaction-logger.sh
# AANY_SCREENSHOT_LOGGER=${AANY_REPO_PATH}/aany-tmux/tmux-screenshot-rotating-logger.sh

# Hub configuration (optional)
# AANY_HUB_URL=localhost:50052

# Logging configuration (optional)
# AANY_LOGGING_DISABLED=false